# Copy to .env and fill in.

PORT=8080
NODE_ENV=development

# Base URL this instance is reachable at. Used to build the OAuth callback.
PUBLIC_URL="http://localhost:8080"

# Dev: the docker compose service below (`bun run db:up`).
# Prod: the Neon *pooled* connection string.
# Validated for shape at boot — never connected to until a query actually runs.
DB_URL="postgresql://platform:platform@localhost:5432/platform"

# --- Phase 1 (auth). Optional until then; required once auth lands. ---

# openssl rand -base64 48
# Rotating this invalidates every session — it is the log-out-everywhere button.
SESSION_SECRET=""

# github.com/settings/developers -> New OAuth App
#   Homepage URL:               $PUBLIC_URL
#   Authorization callback URL: $PUBLIC_URL/auth/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# NUMERIC GitHub ids, not usernames — usernames can be changed and reclaimed.
#   curl -s https://api.github.com/users/<your-username> | jq .id
#
# Comma-separate to let more than one person in: "123456,789012". This stays an
# environment check rather than a database lookup, which is what keeps the whole
# login flow free of queries — see "The one rule" in the README.
ALLOWED_GITHUB_ID=""

# --- Agent observability utility. Optional: absent means the page renders
#     "not configured" and the hourly job is a no-op. ---

# Shared secret the scheduler presents as `Authorization: Bearer ...` to
# POST /internal/jobs/{utility}/{job}. Unset means that endpoint 404s, which is
# the correct default for any instance that is not running scheduled work.
#   openssl rand -base64 48
JOB_SECRET=

# Where the agent's traces live. A cloud project, a BigQuery dataset, and a
# table within it that is hive-partitioned on a `dt` DATE column. The processing
# location must match where the dataset actually is, or the query errors.
AGENT_LOGS_PROJECT=
AGENT_LOGS_DATASET=
AGENT_LOGS_TABLE=
AGENT_LOGS_LOCATION=

# Writes the narratives. Summaries go through the same broker the agent uses, so
# one account covers both — and switching models is an env change, not a deploy.
OPENROUTER_API_KEY=

# Required, no default: model slugs move faster than this file does, and a stale
# default fails as a confusing 400 halfway through a scheduled run. Use the exact
# slug from the broker's model list.
AGENT_SUMMARY_MODEL=

# Optional. Falls back to AGENT_SUMMARY_MODEL. A catch-up reasons over more
# material than one hour, so it is worth pointing at something stronger.
AGENT_CATCHUP_MODEL=

# How thorough each run is: brief | standard | deep. These move sample size,
# output length and the tool budget together — `brief` reads only the fixed
# sample, `deep` investigates before writing. Defaults: standard, deep.
AGENT_SUMMARY_DETAIL=
AGENT_CATCHUP_DETAIL=

# Push notifications, so an urgent finding reaches a phone. Absent means the
# channel is simply off: findings are still computed, stored and shown.
#   Create a bot with @BotFather, then message it and read the chat id from
#   https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Origin used to build links inside notifications. Cosmetic when absent.
AGENT_LINK_BASE=

# The summariser calls the same broker the agent does, so its own requests are
# broadcast into the table it reads. This marker is sent on each request and
# excluded by the reader — without it, every hour would report on the previous
# hour's report. Change it only if the agent could plausibly emit this string.
AGENT_SELF_MARKER=

# Local development only. There is no metadata server on a laptop, so a token
# has to be supplied by hand:
#   gcloud auth print-access-token
AGENT_LOGS_ACCESS_TOKEN=
