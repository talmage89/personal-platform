// Agent observability utility. One file per utility — see base.prisma.

/// How a summary came to exist. Scheduled windows tile the timeline; a manual
/// one is a catch-up covering whatever the schedule had not reached yet.
enum AgentSummaryKind {
  scheduled
  manual
}

/// What the agent did over one bounded window, and what that appeared to mean.
///
/// The numeric columns are computed arithmetically and the narrative is written
/// from them, never the other way round. That ordering is why a stored row can
/// be treated as a record rather than an impression: every figure here can be
/// recomputed from the source table and compared.
model AgentSummary {
  id String @id @default(uuid(7))

  /// Half-open: `[periodStart, periodEnd)`. Scheduled windows are contiguous,
  /// so a gap in the sequence means a run was missed — which is a finding
  /// about the summariser, distinct from a window that was genuinely quiet.
  periodStart DateTime
  periodEnd   DateTime

  kind AgentSummaryKind @default(scheduled)

  callCount  Int
  totalTokens Int
  errorCount Int

  /// Millionths of a dollar, as an integer — the same reasoning as grams in the
  /// weight utility. A float cost is a rounding bug waiting to be argued about,
  /// and a Decimal drags in a runtime for numbers that are only ever summed and
  /// displayed. The ceiling is a little over $2,100 per window, which is orders
  /// of magnitude above anything an hour of this agent could plausibly spend.
  costMicroUsd Int

  /// Median prompt size across the window. Stored because the trailing baseline
  /// needs it and recomputing it would mean re-reading the raw traces.
  medianPromptTokens Int

  /// `[{ model, calls, costUsd, totalTokens }]`, ordered by call count.
  models Json

  /// `[{ code, severity, detail }]` — the deterministic findings.
  flags Json

  narrative String

  /// `[{ name, args, ok }]` — what the summariser went and read beyond the
  /// sample it was handed. Nullable because summaries written before the
  /// summariser could investigate have nothing to record here, and an empty
  /// array would claim it looked and found nothing.
  investigation Json?

  /// `[{ severity, message, sentAt }]` — push notifications this summary sent.
  alerts Json?

  /// What writing the summary cost, in millionths of a dollar. Kept apart from
  /// `costMicroUsd` on purpose: one is the agent's spend and the other is the
  /// price of watching it, and adding them together would flatter neither.
  narrationMicroUsd Int @default(0)

  createdAt DateTime @default(now())

  /// Makes a re-run idempotent: replaying the same scheduled window updates the
  /// row rather than laying a duplicate beside it.
  @@unique([periodStart, periodEnd, kind])
  @@index([periodEnd])
}

/// Where a person had read up to. Drives "summarise since last time".
model AgentView {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastViewedAt DateTime

  updatedAt DateTime @updatedAt
}

/// State of the push channel. A single row, id "default".
///
/// Exists so the summariser can prove the channel still works. A notification
/// path nobody has exercised is indistinguishable from a quiet week right up
/// until the moment it matters, so a probe goes out on a widening interval —
/// hourly at first, then doubling to a weekly floor of confidence. Any real
/// alert resets the clock, so a channel in active use sends no probes at all.
model AgentChannel {
  id String @id @default("default")

  /// When anything last arrived on the channel, probe or alert.
  lastSendAt DateTime?

  /// Current gap between probes, in minutes. Doubles after each one.
  intervalMinutes Int @default(60)

  /// Set when a send failed, cleared when one succeeds. Surfaced on the page,
  /// because a broken channel is itself the alarm that cannot ring.
  lastError String?

  updatedAt DateTime @updatedAt
}

/// Which prompt. `system` is the shared framing the two summary prompts are
/// held to; `hourly` writes up one window; `recap` accounts for many. `chat`
/// stands apart — it is the whole system prompt for the conversation page,
/// including how insistently the notes are to be used, and is not held to the
/// shared framing because it is answering a person rather than filing a report.
enum AgentPromptKind {
  system
  hourly
  recap
  chat
}

/// An edited prompt, overriding the one compiled into the build.
///
/// A row exists only when the prompt has been changed — absence means "use the
/// default", so resetting is a delete and the defaults stay in code where they
/// are reviewed and versioned. The useful edits here are the ones you think of
/// after reading a summary that missed something, and waiting for a deploy to
/// try them is the difference between tuning this and not bothering.
model AgentPrompt {
  kind AgentPromptKind @id

  body String

  updatedAt DateTime @updatedAt
}

/// Who said it. Tool results and the model's own lookups are not turns — they
/// are recorded on the assistant message that produced them, in `investigation`.
enum AgentChatRole {
  user
  assistant
}

/// One conversation with the summariser about the state of the system.
///
/// The hourly summaries answer "what happened in this window". They cannot
/// answer "has it ever done this before", "what is normal for a Tuesday", or
/// "why does it keep retrying that one file" — questions that range across the
/// whole record rather than sitting inside one window. This is that surface: a
/// thread, the same log-reading tools the summariser has, and the notes below.
///
/// Threads rather than one rolling conversation, because the questions are
/// unrelated to each other. "What was that spike on Tuesday" does not want the
/// last month of unrelated context in its prompt, and paying to carry it would
/// make every answer worse as well as dearer.
model AgentChat {
  id String @id @default(uuid(7))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The opening question, trimmed. Enough to recognise the thread by; not
  /// worth a model call to title it more elegantly.
  title String

  /// Set when a job has been asked for a reply and has not delivered one.
  ///
  /// An answer takes minutes — it reads the warehouse — so it cannot be written
  /// inside the request that asked for it; the page renders from this and says
  /// so. Cleared whether the job succeeds or fails, so a thread cannot be
  /// wedged in "thinking" by a crash.
  pendingSince DateTime?

  /// Why the last attempt produced nothing. Shown on the thread, cleared by the
  /// next successful answer.
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AgentChatMessage[]

  @@index([userId, updatedAt])
}

/// One turn. The whole thread is replayed into the prompt, oldest first.
model AgentChatMessage {
  id String @id @default(uuid(7))

  chatId String
  chat   AgentChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role AgentChatRole
  body String

  /// `[{ name, args, ok }]` — what the answer went and read. Recorded for the
  /// same reason the summaries record it: an answer that checked and an answer
  /// that guessed read exactly alike, and only one of them is evidence.
  investigation Json?

  /// What this turn cost to produce, in millionths of a dollar. Zero on a
  /// question, since asking one is free.
  costMicroUsd Int @default(0)

  createdAt DateTime @default(now())

  @@index([chatId, createdAt])
}

/// Something learned once and worth not re-deriving.
///
/// The logs only ever get longer, and every answer that has to rediscover what
/// this agent is *for* — which repositories it works on, what its ordinary day
/// costs, which of its habits have already been explained and dismissed — pays
/// for that discovery again. A note is the durable half of a conversation.
///
/// Written by the chat through a tool and editable by hand on the memory page,
/// because the failure mode of a memory nobody can see is a wrong fact repeated
/// with growing confidence. The `summary` line of every note is in the prompt of
/// every conversation; the body is read on demand.
model AgentNote {
  /// A stable handle the model chooses, e.g. "what-the-agent-works-on". Also
  /// how it overwrites its own note rather than accumulating near-duplicates.
  key String @id

  /// One line. This is what is always in context, so it carries the fact
  /// itself rather than a description of where the fact is.
  summary String

  body String

  /// Which conversation last wrote it, or null when a person edited it here.
  /// Not a relation: a note outlives the thread that produced it, and losing
  /// the note when the thread is deleted would be the wrong end of the trade.
  sourceChatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
