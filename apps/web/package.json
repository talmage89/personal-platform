{
  "name": "@platform/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "run-p dev:css dev:server",
    "dev:server": "bun --hot --env-file=../../.env src/index.ts",
    "dev:css": "tailwindcss -i src/styles.css -o public/styles.css --watch",
    "build": "run-s build:css build:server",
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "build:server": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "NODE_ENV=production bun dist/index.js",
    "check:types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@platform/auth": "workspace:*",
    "@platform/core": "workspace:*",
    "@tailwindcss/cli": "^4.1.18",
    "hono": "^4.11.4",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
