{
  "name": "personal-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @platform/web dev",
    "build": "bun run --filter @platform/web build",
    "start": "NODE_ENV=production bun apps/web/dist/index.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "bun run --filter '*' test",
    "check": "run-s check:lint check:types",
    "check:fix": "run-s check:lint:fix check:types",
    "check:lint": "biome check .",
    "check:lint:fix": "biome check --fix .",
    "check:types": "bun run --filter '*' check:types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "latest",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
